  },
  {
   "depends_on": "eval:doc.campaign_type=='Event Invitation'",
   "mandatory_depends_on": "eval:doc.campaign_type=='Event Invitation'",
   "fieldname": "event_datetime",
   "fieldtype": "Datetime",
   "label": "زمان رویداد"
  },
  {
   "depends_on": "eval:doc.campaign_type=='Event Invitation'",
